{
  "extends": ["expo/tsconfig.base", "@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}

# Only this e-mail address may create the first account (it becomes the admin). Strongly recommended.
ADMIN_EMAIL=
# Public URL of this app (used for links in notifications), e.g. https://tweedekans.example.nl
APP_URL=
# Base URL of your ntfy server; every user gets a personal topic below it.
NTFY_BASE_URL=
# Upgrading from the single-user version? Keep your old AUTH_PASSWORD here once: it becomes the
# password of the ADMIN_EMAIL account, which also adopts the existing data. Remove it afterwards.
AUTH_PASSWORD=
# Interface the port is published on (127.0.0.1 = host only)
APP_BIND=0.0.0.0
# Host port for the web UI
APP_PORT=8090
POLL_INTERVAL_MIN=15
# Optional: openssl rand -hex 32  (leave empty to auto-generate a key in the data volume)
SECRET_KEY=

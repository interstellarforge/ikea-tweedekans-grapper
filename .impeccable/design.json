  "narrative": {
    "northStar": "The Shop-Floor Companion",
    "overview": "The app speaks IKEA's own visual language: a blue field, a yellow action, price-tag numerals and assembly-sheet logic. It is a tool used one-handed in a car park or a store, so it is dense, flat and legible rather than decorative. Everything that is not a number or an action recedes into cool off-white (dark mode: ink-blue).\n\nDepth comes from 1px rules and tonal surfaces; shadows are soft, real-offset and used sparingly. Radii are small (8px controls, 14px containers). One icon stroke (1.75px) and one typeface (Noto Sans, self-hosted) carry the whole system. The landing rejects the SaaS template (centred headline, three icon cards, logo wall) and proves its mechanism with real UI fragments labelled \"Voorbeeld\".",
    "keyCharacteristics": [
      "Blue owns identity (header, hero, aside, primary buttons); yellow owns the single action and the focus ring.",
      "Prices are the loudest type: heavy numerals, tabular figures, raised cents on the landing tag.",
      "Flat 1px rules (line, line-strong) separate content; 2px ink rules mark assembly-sheet steps and totals.",
      "Light and dark both first-class via prefers-color-scheme.",
      "Status always carries text, never colour alone."
    ],
    "rules": [
      {
        "name": "The One Action Rule",
        "body": "Yellow marks the single most important action or signal on a surface; blue is identity and default buttons.",
        "section": "colors"
      },
      {
        "name": "The Text-On-Yellow Rule",
        "body": "Text on yellow is always fg ink, never white.",
        "section": "colors"
      },
      {
        "name": "The Status Pair Rule",
        "body": "Status colour text sits on its -bg tint and is accompanied by words or an icon.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Prices, quantities, durations and table cells use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Weight-Not-Face Rule",
        "body": "Hierarchy comes from weight and size inside Noto Sans; no second display face.",
        "section": "typography"
      },
      {
        "name": "The Real Offset Rule",
        "body": "Shadows have blur and a real offset and soften; no hard zero-blur offsets.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use var(--*) tokens; the dark theme works only through them.",
      "Do reserve yellow for the one action, focus and small signals; put ink text on it.",
      "Do show money in euros with tabular numerals, prefix estimates with \"~\".",
      "Do use the shared inline SVG icon set at stroke 1.75px for every icon.",
      "Do use custom dialog.modal instead of native popups.",
      "Do label demonstration fragments \"Voorbeeld\" and keep the unofficial, not-affiliated-with-IKEA note near actions."
    ],
    "donts": [
      "Don't use emoji or glyph characters as icons.",
      "Don't use a second typeface or system display face for headings.",
      "Don't signal status by colour alone.",
      "Don't add gradient fills, glassmorphism or hard offset shadows.",
      "Don't build the landing from centred hero, three icon cards and a logo wall.",
      "Don't claim partnership, testimonials, counts or press that do not exist."
    ]
  }
